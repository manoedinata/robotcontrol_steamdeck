# Ignore Git metadata and editor files
.git
.gitignore
.vscode

# Recorded video never belongs in the image
recordings

# Local virtual environments and node_modules
backend/venv
frontend/node_modules
frontend/dist
frontend/.vite

# Local settings/credentials (will be mounted at runtime)
frontend/settings.json
frontend/settings.json.tmp-*

# Local simulation scripts are optional and not needed inside the image
scripts/udp_server_simulation.py

# Documentation files and metadata are not needed in the runtime image
*.md
AGENTS.md
frontend/docs
backend/__pycache__
backend/*.pyc
